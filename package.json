{
  "name": "@SPHTech-CQ/figma-tailwind-compiler",
  "version": "1.0.0",
  "description": "ZB design system figma to tailwind config",
  "exports": {
    "./zb/tailwind3": "./dist/zb/tailwind3/tailwind.config.js",
    "./zb/tailwind4": "./dist/zb/tailwind4/index.css",
    "./zbschools/tailwind4": "./dist/zbschools/tailwind4/index.css"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build:tsc": "tsc -p tsconfig.json",
    "build:plugin": "pnpm run build:tsc",
    "build": "pnpm run zb:tailwind4 && pnpm run zb:tailwind3 && pnpm run zbschools:tailwind4",
    "zb:tailwind4": "node scripts/figmatotailwind.mjs",
    "zb:tailwind3": "node scripts/figmatotailwind3.mjs",
    "zbschools:tailwind4": "pnpm exec node scripts/zbschools.mjs",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix .",
    "watch": "pnpm run build:tsc --watch"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.123.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
