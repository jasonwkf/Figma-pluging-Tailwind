{
  "name": "@SPHTech-CQ/figma-tailwind-compiler",
  "version": "1.0.0",
  "description": "ZB design system figma to tailwind config",
  "exports": {
    "./tailwind3": "./dist/tailwind3/tailwind.config.js",
    "./tailwind4": "./dist/tailwind4/index.css",
    "./zbschool/tailwind4": "./dist/zbschool/index.css"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build:tsc": "tsc -p tsconfig.json",
    "build": "pnpm run build:tsc",
    "tailwind:output": "pnpm run tailwind4:output && pnpm run tailwind3:output",
    "tailwind4:output": "node scripts/figmatotailwind.mjs",
    "tailwind3:output": "node scripts/figmatotailwind3.mjs",
    "zbschool:output": "node scripts/zbschool.mjs",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix .",
    "watch": "pnpm run build:tsc --watch"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.123.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
